+def make_raster_settings(viewpoint_camera, bg_color, scaling_modifier, pipe):
+    tanfovx = math.tan(viewpoint_camera.FoVx * 0.5)
+    tanfovy = math.tan(viewpoint_camera.FoVy * 0.5)
+    kwargs = dict(
+        image_height=int(viewpoint_camera.image_height),
+        image_width=int(viewpoint_camera.image_width),
+        tanfovx=tanfovx,
+        tanfovy=tanfovy,
+        bg=bg_color,
+        scale_modifier=scaling_modifier,
+        viewmatrix=viewpoint_camera.world_view_transform,
+        projmatrix=viewpoint_camera.full_proj_transform,
+        sh_degree=1,
+        campos=viewpoint_camera.camera_center,
+        prefiltered=False,
+        debug=pipe.debug,
+    )
+    return GaussianRasterizationSettings(**kwargs)
+
+def append_res_condition(features, viewpoint_camera, pc, visible_mask=None):
+    return features
+
+def get_lens_condition_alpha(viewpoint_camera, anchor, features):
+    projection = viewpoint_camera.full_proj_transform.to(dtype=features.dtype, device=features.device)
+    anchor_h = torch.cat(
+        [
+            anchor.to(dtype=features.dtype, device=features.device),
+            torch.ones((anchor.shape[0], 1), dtype=features.dtype, device=features.device),
+        ],
+        dim=1,
+    )
+    projected = anchor_h @ projection
+    w = projected[:, 3:4]
+    eps = torch.full_like(w, 1e-7)
+    w_safe = torch.where(w.abs() < eps, eps, w)
+    ndc_xy = projected[:, :2] / w_safe
+
+    # Match the square-padded image coordinates used by the lens pipeline.
+    # For square images this is raw NDC; for rectangular images the shorter
+    # axis is compressed exactly as `pad_to_square` would place it.
+    width = int(viewpoint_camera.image_width)
+    height = int(viewpoint_camera.image_height)
+    side = max(width, height)
+    denom = max(side - 1, 1)
+    axis_scale = torch.tensor(
+        [max(width - 1, 1) / denom, max(height - 1, 1) / denom],
+        dtype=features.dtype,
+        device=features.device,
+    )
+    square_xy = ndc_xy * axis_scale
+    radius = torch.linalg.norm(square_xy, dim=1, keepdim=True)
+    radius_max = float(getattr(viewpoint_camera, "lens_condition_radius_max_norm", math.sqrt(2.0)))
+    fixed_alpha = getattr(viewpoint_camera, "xrgs_fixed_lens_alpha", None)
+    if fixed_alpha is not None:
+        value = torch.as_tensor(fixed_alpha, dtype=features.dtype, device=features.device)
+        value = value.reshape(-1)[0].clamp(0.0, 1.0)
+        return (torch.ones_like(radius) * value).detach()
+    return torch.clamp(radius / max(radius_max, 1e-6), 0.0, 1.0).detach()
+
+def prepare_res_condition_plugin(pc, viewpoint_camera, features, visible_mask):
+    if not pc.uses_res_cond_plugin():
+        return None
+    if visible_mask is None:
+        raise ValueError("Unified plug-in condition requires visible_mask")
+    if getattr(pc, "res_cond_mode", "scalar") != "learned_anchor_multi_plugin":
+        raise ValueError(f"Unsupported res_cond_mode for XRGS unified path: {pc.res_cond_mode}")
+    res_cond_anchor = pc._res_cond_anchor[visible_mask].to(dtype=features.dtype, device=features.device)
+    layout = getattr(pc, "res_cond_plugin_layout", None)
+    if layout is None:
+        raise ValueError("learned_anchor_multi_plugin requires pc.res_cond_plugin_layout")
+    alphas = torch.zeros_like(res_cond_anchor)
+    if "ss" in layout:
+        start, end = layout["ss"]
+        # Per-view XRGS condition scalars live on the camera to avoid changing the Scaffold-GS renderer API.
+        ss_alpha = getattr(viewpoint_camera, "ss_res_cond", getattr(viewpoint_camera, "res_cond", 0.0))
+        if torch.is_tensor(ss_alpha):
+            ss_alpha = ss_alpha.to(dtype=features.dtype, device=features.device).reshape(-1)[0]
+        else:
+            ss_alpha = torch.tensor(float(ss_alpha), dtype=features.dtype, device=features.device)
+        alphas[:, start:end] = ss_alpha
+    if "display" in layout:
+        start, end = layout["display"]
+        display_alpha = getattr(viewpoint_camera, "display_res_cond", 0.0)
+        if torch.is_tensor(display_alpha):
+            display_alpha = display_alpha.to(dtype=features.dtype, device=features.device).reshape(-1)[0]
+        else:
+            display_alpha = torch.tensor(float(display_alpha), dtype=features.dtype, device=features.device)
+        alphas[:, start:end] = display_alpha
+    if "lens" in layout:
+        start, end = layout["lens"]
+        anchor = pc.get_anchor[visible_mask]
+        lens_alpha = get_lens_condition_alpha(viewpoint_camera, anchor, features)
+        alphas[:, start:end] = lens_alpha
+    if not torch.any(alphas != 0) and not torch.is_grad_enabled():
+        return None
+    return res_cond_anchor, alphas
+
+def run_res_conditioned_mlp(pc, mlp, proj, features, viewpoint_camera, visible_mask, plugin_condition=None):
+    if not pc.uses_res_cond_plugin():
+        return mlp(features)
+    if plugin_condition is None:
+        return mlp(features)
+    modules = mlp._modules
+    first_layer = modules["0"]
+    res_cond_anchor, res_alpha = plugin_condition
+    combined_features = torch.cat([features, res_alpha * res_cond_anchor], dim=1)
+    combined_weight = torch.cat([first_layer.weight, proj.weight.to(dtype=first_layer.weight.dtype)], dim=1)
+    output = F.linear(combined_features, combined_weight, first_layer.bias)
+    for idx in range(1, len(modules)):
+        output = modules[str(idx)](output)
+    return output
+
